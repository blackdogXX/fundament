@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    <div class="text-center mt-5"><div class="spinner-border"></div></div>
                </Authorizing>
                <NotAuthorized>
                    @{
                        Nav.NavigateTo("/Account/Login", forceLoad: true);
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <PageTitle>404</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="text-center mt-5"><h1>404</h1><p>Страница не найдена</p><a href="/" class="btn btn-primary">На главную</a></div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
