@inherits LayoutComponentBase

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <HeadOutlet />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#c1440e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Фундамент" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (e) {
                    console.error('SW registration failed:', e);
                });
            });
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="css/themes.css" rel="stylesheet" />
    <style>
        .brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #c1440e 0%, #d4693a 100%);
            border-radius: 5px;
            position: relative;
            margin-right: 8px;
            box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2);
        }
        .brand-icon::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                linear-gradient(to bottom, transparent 0, transparent 9px, #e8d5c4 9px, #e8d5c4 11px, transparent 11px, transparent 21px, #e8d5c4 21px, #e8d5c4 23px, transparent 23px, transparent 32px),
                linear-gradient(to right, transparent 0, transparent 9px, #e8d5c4 9px, #e8d5c4 11px, transparent 11px, transparent 21px, #e8d5c4 21px, #e8d5c4 23px, transparent 23px, transparent 32px);
            border-radius: 5px;
            opacity: 0.6;
        }
        .brand-icon i {
            font-size: 16px;
            color: #ffffff;
            z-index: 1;
            text-shadow: 0 1px 2px rgba(0,0,0,0.4);
        }
        body { font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; }
    </style>
</head>
<body>
    <div class="container mt-5">
        <div class="text-center mb-4">
            <span class="brand-icon" style="width:48px;height:48px;"><i class="bi bi-bricks" style="font-size:24px;color:#fff;"></i></span>
            <h3 style="font-weight:700;letter-spacing:.3px;font-family:'Inter',sans-serif;display:inline-block;vertical-align:middle;">FUNDAMENT</h3>
        </div>
        @Body
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/charts.js"></script>
    <script src="js/themes.js"></script>
    <script src="js/themes.js"></script>
    <script>
    function toggleField(inputId, iconId) {
        var f = document.getElementById(inputId);
        var i = document.getElementById(iconId);
        if (f && i) {
            if (f.type === 'password') { f.type = 'text'; i.className = 'bi bi-eye-slash'; }
            else { f.type = 'password'; i.className = 'bi bi-eye'; }
        }
    }
    </script>
    <script src="/_framework/blazor.web.js"></script>
    <script src="/js/pwa.js"></script>
</body>
</html>
