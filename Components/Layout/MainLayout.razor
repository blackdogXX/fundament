@inherits LayoutComponentBase

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" /><base href="/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#c1440e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Фундамент" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (e) {
                    console.error('SW registration failed:', e);
                });
            });
        }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="/css/mobile.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        .brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #c1440e 0%, #d4693a 100%);
            border-radius: 5px;
            position: relative;
            margin-right: 8px;
            box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2);
        }
        .brand-icon::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background:
                linear-gradient(to bottom, transparent 0, transparent 9px, #e8d5c4 9px, #e8d5c4 11px, transparent 11px, transparent 21px, #e8d5c4 21px, #e8d5c4 23px, transparent 23px, transparent 32px),
                linear-gradient(to right, transparent 0, transparent 9px, #e8d5c4 9px, #e8d5c4 11px, transparent 11px, transparent 21px, #e8d5c4 21px, #e8d5c4 23px, transparent 23px, transparent 32px);
            border-radius: 5px;
            opacity: 0.6;
        }
        .brand-icon i {
            font-size: 16px;
            color: #ffffff;
            z-index: 1;
            text-shadow: 0 1px 2px rgba(0,0,0,0.4);
        }
        body { font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif; }
        .navbar-brand { font-weight: 700; letter-spacing: .3px; font-family: "Inter", sans-serif; }
        .card { transition: background-color 0.3s, color 0.3s; }
        .text-bg-success { background-color: #2f7d5c !important; }
        .text-bg-danger { background-color: #b8433a !important; }
        :root { --accent-color: #c1440e; }
        .navbar { background-color: var(--accent-color) !important; }
        .bg-primary { background-color: var(--accent-color) !important; }
        .btn-primary { background-color: var(--accent-color); border-color: var(--accent-color); }
        .btn-primary:hover { filter: brightness(1.1); }
        .btn-outline-primary { color: var(--accent-color); border-color: var(--accent-color); }
        .btn-outline-primary:hover { background-color: var(--accent-color); color: #fff; }
        .badge.bg-primary { background-color: var(--accent-color) !important; }
        .text-primary { color: var(--accent-color) !important; }
        a { color: var(--accent-color); }
        .progress-bar { background-color: var(--accent-color) !important; }
        .nav-link { color: rgba(255,255,255,0.8) !important; }
        .nav-link:hover { color: #fff !important; }
        .nav-link.active { color: #fff !important; background-color: rgba(255,255,255,0.15) !important; border-radius: 5px; }
        .navbar-brand { color: #fff !important; }
    </style>
    <HeadOutlet />
</head>
<body>
    <NavMenu />
    <BottomNav />
    <div class="container-fluid px-4">@Body</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/charts.js"></script>
    <script src="js/themes.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="/js/pwa.js"></script>
    <script src="/js/bottomnav.js"></script>
</body>
</html>
