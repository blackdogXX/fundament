@page "/Account/Login"
@using Microsoft.AspNetCore.Identity
@using ConstructionFinance.Models
@inject SignInManager<AppUser> SM
@inject UserManager<AppUser> UM
@inject NavigationManager Nav
@layout LoginLayout
<PageTitle>Fundament — Вход</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-4">
        <h2 class="text-center mb-4">Вход</h2>
        <EditForm Model="m" OnValidSubmit="DoLogin" FormName="f1">
            <DataAnnotationsValidator />
            <div class="mb-3"><label class="form-label">Email</label><InputText @bind-Value="m.Email" class="form-control" /><ValidationMessage For="() => m.Email" /></div>
            <div class="mb-3">
                <label class="form-label">Пароль</label>
                <div class="input-group">
                    <InputText @bind-Value="m.Pass" id="passField" type="password" class="form-control" />
                    <span class="input-group-text" onclick="toggleField('passField','passIcon')" style="cursor:pointer;">
                        <i class="bi bi-eye" id="passIcon"></i>
                    </span>
                </div>
                <ValidationMessage For="() => m.Pass" />
            </div>
            <p class="text-danger">@err</p>
            <button type="submit" class="btn btn-primary w-100">Войти</button>
        </EditForm>
        <div class="text-center mt-3"><a href="/Account/Register">Регистрация</a></div>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private M m { get; set; } = new();
    private string? err;
    public class M { [Required] public string Email { get; set; } = ""; [Required] public string Pass { get; set; } = ""; }
    private async Task DoLogin() {
        var u = await UM.FindByEmailAsync(m.Email);
        if (u != null) { var r = await SM.PasswordSignInAsync(u.UserName!, m.Pass, false, false); if (r.Succeeded) { Nav.NavigateTo("/", forceLoad: true); return; } }
        err = "Неверный email или пароль";
    }
}
