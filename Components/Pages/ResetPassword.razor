@page "/Account/ResetPassword"
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ConstructionFinance.Models
@inject UserManager<AppUser> UM
@layout LoginLayout
<PageTitle>Fundament — Новый пароль</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-4">
        @if (done)
        {
            <div class="text-center">
                <div class="mb-3" style="font-size:44px;color:#2f7d5c;"><i class="bi bi-check-circle"></i></div>
                <h4>Пароль изменён</h4>
                <p class="text-muted">Войдите с новым паролем.</p>
                <a href="/Account/Login" class="btn btn-primary mt-2">Войти</a>
            </div>
        }
        else if (badLink)
        {
            <div class="text-center">
                <div class="mb-3" style="font-size:44px;color:#b8433a;"><i class="bi bi-x-circle"></i></div>
                <h4>Ссылка недействительна</h4>
                <p class="text-muted">@err</p>
                <a href="/Account/ForgotPassword" class="btn btn-outline-primary mt-2">Запросить новую ссылку</a>
            </div>
        }
        else
        {
            <h2 class="text-center mb-4">Новый пароль</h2>
            <EditForm Model="m" OnValidSubmit="Submit" FormName="rp">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Новый пароль</label>
                    <div class="input-group">
                        <InputText @bind-Value="m.Pass" id="rpPass" type="password" class="form-control" />
                        <span class="input-group-text" onclick="toggleField('rpPass','rpPassIcon')" style="cursor:pointer;">
                            <i class="bi bi-eye" id="rpPassIcon"></i>
                        </span>
                    </div>
                    <ValidationMessage For="() => m.Pass" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Подтверждение</label>
                    <div class="input-group">
                        <InputText @bind-Value="m.Confirm" id="rpConfirm" type="password" class="form-control" />
                        <span class="input-group-text" onclick="toggleField('rpConfirm','rpConfirmIcon')" style="cursor:pointer;">
                            <i class="bi bi-eye" id="rpConfirmIcon"></i>
                        </span>
                    </div>
                    <ValidationMessage For="() => m.Confirm" />
                </div>
                <p class="text-danger">@err</p>
                <button type="submit" class="btn btn-primary w-100">Сохранить пароль</button>
            </EditForm>
            <div class="text-center mt-3"><a href="/Account/Login">Вернуться ко входу</a></div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Code { get; set; }
    [SupplyParameterFromForm] private M m { get; set; } = new();

    private bool done, badLink;
    private string? err;

    public class M
    {
        [Required(ErrorMessage = "Укажите пароль")]
        [MinLength(4, ErrorMessage = "Минимум 4 символа")]
        public string Pass { get; set; } = "";

        [Required(ErrorMessage = "Повторите пароль")]
        [Compare("Pass", ErrorMessage = "Пароли не совпадают")]
        public string Confirm { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(UserId) || string.IsNullOrEmpty(Code))
        {
            badLink = true;
            err = "Ссылка неполная. Откройте её из письма целиком.";
        }
    }

    private async Task Submit()
    {
        err = null;

        var user = await UM.FindByIdAsync(UserId!);
        if (user == null)
        {
            badLink = true;
            err = "Пользователь не найден — возможно, учётная запись была удалена.";
            return;
        }

        string token;
        try
        {
            token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code!));
        }
        catch
        {
            badLink = true;
            err = "Ссылка повреждена. Запросите новую.";
            return;
        }

        var result = await UM.ResetPasswordAsync(user, token, m.Pass);
        if (result.Succeeded)
        {
            // Сброс пароля через письмо подтверждает владение адресом.
            if (!await UM.IsEmailConfirmedAsync(user))
            {
                var confirmToken = await UM.GenerateEmailConfirmationTokenAsync(user);
                await UM.ConfirmEmailAsync(user, confirmToken);
            }
            done = true;
            return;
        }

        if (result.Errors.Any(e => e.Code == "InvalidToken"))
        {
            badLink = true;
            err = "Ссылка недействительна или истекла (она живёт 24 часа).";
            return;
        }

        err = string.Join("; ", result.Errors.Select(e => e.Description));
    }
}
